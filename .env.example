# 复制为 .env 后填入真实密钥（.env 已被 gitignore，不会提交）
# 大模型走 OpenAI 兼容接口（当前配置讯飞 MaaS Spark-X2.6）。
# 字段名 DEEPSEEK_API_KEY 为历史遗留，实际填入当前平台 Key 即可；BASE_URL/MODEL_NAME 见下方注释。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选覆盖项（默认值见 app/config/settings.py）
# MODEL_NAME=spark-x2.6
# BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
# TEMPERATURE=0.3
# MAX_TOKENS=4096

# Docker 部署：docker compose up -d --build（密钥经 env_file 注入容器，不进镜像）
