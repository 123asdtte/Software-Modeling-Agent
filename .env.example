# 复制为 .env 后填入真实密钥（.env 已被 gitignore，不会提交）
# 大模型走 TokenRhythm（基元律动）平台：OpenAI 兼容接口，base_url 需带 /v1
# 文档：https://tokenrhythm.studio/docs/api-integration
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选覆盖项（默认值见 app/config/settings.py）
# MODEL_NAME=glm-5.3-flash
# BASE_URL=https://tokenrhythm.studio/v1
# TEMPERATURE=0.3
# MAX_TOKENS=4096

# Docker 部署：docker compose up -d --build（密钥经 env_file 注入容器，不进镜像）
